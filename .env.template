# cloudmesh-ai-llm Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# VLLM / API Configuration
# =============================================================================

# API Key for vLLM server access
VLLM_API_KEY=your_api_key_here

# Model to use (e.g., gemma, llama3, mixtral)
VLLM_MODEL=gemma

# GPU memory utilization (0.0 to 1.0)
VLLM_GPU_MEMORY_UTILIZATION=0.9

# Maximum model length in tokens
VLLM_MAX_MODEL_LEN=4096

# Tensor parallel size (for multi-GPU)
VLLM_TENSOR_PARALLEL_SIZE=1

# Data type (auto, float16, bfloat16, float32)
VLLM_DTYPE=auto

# =============================================================================
# Cloudmesh Configuration
# =============================================================================

# User configuration (typically auto-detected from SSH config)
CLOUDMESH_AI_USER=your_username

# Server host
CLOUDMESH_AI_HOST=localhost

# Server port
CLOUDMESH_AI_PORT=8000

# API key (alternative to VLLM_API_KEY)
CLOUDMESH_AI_API_KEY=your_api_key_here

# =============================================================================
# SSH Configuration (for remote deployments)
# =============================================================================

# SSH host alias from ~/.ssh/config
SSH_HOST=your_remote_host

# SSH username (if not in SSH config)
SSH_USER=your_username

# SSH private key path
SSH_KEY_PATH=~/.ssh/id_rsa

# =============================================================================
# Server-Specific Configuration (using double underscores for nesting)
# =============================================================================

# Example: Set port for uva.gemma server
# CLOUDMESH_AI_SERVER__UVA__GEMMA__REMOTE_PORT=8000

# Example: Set model for specific server
# CLOUDMESH_AI_SERVER__UVA__LLAMA3__MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# =============================================================================
# Docker Configuration (for containerized deployments)
# =============================================================================

# Docker image to use
DOCKER_IMAGE=vllm/vllm-openai:latest

# Container name
DOCKER_CONTAINER_NAME=vllm-server

# Docker network mode
DOCKER_NETWORK=host

# =============================================================================
# Development/Testing Configuration
# =============================================================================

# Enable debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Notes:
# =============================================================================
# 1. Environment variables override YAML configuration values
# 2. Use double underscores (__) to represent nested config paths
#    Example: CLOUDMESH_AI_SERVER__UVA__GEMMA__PORT becomes cloudmesh.ai.server.uva.gemma.port
# 3. Boolean values: use true/false, yes/no, 1/0, on/off
# 4. Lists: use comma-separated values
# 5. This template shows all available options - you only need to set what you want to override